{
    "label" : "logout",
    "action" : "loginctl terminate-user $USER",
    "text" : "Logout [L]",
    "keybind" : "l"
}
{
    "label" : "shutdown",
    "action" : "hyprshutdown --post-cmd 'systemctl poweroff'",
    "text" : "Shutdown [S]",
    "keybind" : "s"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Suspend [U]",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "hyprshutdown --post-cmd 'systemctl reboot'",
    "text" : "Reboot [R]",
    "keybind" : "r"
}
