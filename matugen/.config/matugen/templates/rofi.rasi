/* Generated by matugen — do not edit directly */

* {
    font:   "Iosevka Nerd Font Medium 14";

    bg0:     {{ colors.surface_dim.default.hex }};
    bg1:     {{ colors.surface_container.default.hex }};
    fg0:     {{ colors.on_surface.default.hex }};

    accent-color:     {{ colors.primary.default.hex }};
    urgent-color:     {{ colors.tertiary.default.hex }};

    background-color:   transparent;
    text-color:         @fg0;

    margin:     0;
    padding:    0;
    spacing:    0;
}

window {
    location:           center;
    background-color:   @bg0;
    border-radius:      6px;
    width:              35%;
}

inputbar {
    spacing:    8px; 
    padding:    8px;

    background-color:   @bg1;
    // children:["textbox-prompt-colon","entry"];
    children:["entry"];
}

/*
textbox-prompt-colon {
     text-color: inherit;
     expand: false;
     margin: 0 0em 0em 0em;
     str: " ";
}
*/

prompt, entry, element-icon, element-text {
    vertical-align: 0.5;
}

prompt, entry {
    text-color: @accent-color;
    vertical-align:0;
}

textbox {
    padding:            8px;
    background-color:   @bg1;
}

listview {
    padding:    4px 0;
    lines:      10;
    columns:    1;

    fixed-height:   true;
}

element {
    padding:    8px;
    spacing:    8px;
}

element normal normal {
    text-color: @fg0;
}

element normal urgent {
    text-color: @urgent-color;
}

element normal active {
    text-color: @accent-color;
}

element selected {
    text-color: @bg0;
}

element selected normal, element selected active {
    background-color:   @accent-color;
}

element selected urgent {
    background-color:   @urgent-color;
}

element-icon {
    size:   0.8em;
}

element-text {
    text-color: inherit;
}
